# ---------------------------------------------------------------------------
# JobPilot AI — environment configuration
# Copy to `.env` and fill in. The app runs fully with the defaults below,
# using mock providers, so no third-party keys are required for local dev.
# ---------------------------------------------------------------------------

# Database — PostgreSQL only (ADR-0002). SQLite is no longer supported: the
# tenancy backstop is row-level security, which SQLite does not have.
#
# DATABASE_URL  — what the application connects to. On Supabase this is the
#                 TRANSACTION-mode pooler (port 6543, `?pgbouncer=true`).
# DIRECT_URL    — what `prisma migrate` connects to. On Supabase this is the
#                 SESSION-mode pooler or the direct host (port 5432). Migrations
#                 need a connection that survives across statements.
#
# A password containing URL-reserved characters is percent-encoded for you:
# the application does it in src/lib/db-url.ts, and every `npm run db:*`
# script runs the Prisma CLI through scripts/db/with-encoded-env.mjs. Calling
# `npx prisma …` directly bypasses that wrapper, so encode DIRECT_URL yourself
# if you do.
#
# BOTH variables must authenticate as the SAME database role. The row-level
# security migration binds the system role's access to the role that runs it,
# so an application login role that differs from the migration role would see
# no rows at all (fail closed). On Supabase both are `postgres.<ref>`.
#
# Local development: any PostgreSQL 16, e.g.
#   createdb jobpilot_dev
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/jobpilot_dev"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/jobpilot_dev"

# Session signing secret — MUST be replaced in production (32+ chars)
AUTH_SECRET="dev-only-secret-change-me-in-production-0123456789"

# Where generated application folders are written
STORAGE_ROOT="./storage"

# --- Headless CMS (Payload) ------------------------------------------------
# The CMS runs inside this same Next.js app: admin UI at /admin, REST at
# /api/cms, GraphQL at /api/cms/graphql.
#
# It keeps its OWN database, separate from DATABASE_URL above. Prisma owns
# transactional product data (users, applications, subscriptions); Payload owns
# editorial content (pages, blog, learning paths, career guides,
# certifications). Two lifecycles, two backup stories, no shared tables.
# Either a SQLite file (local only) or a PostgreSQL URL. The adapter is chosen
# from the scheme: `file:` selects SQLite, `postgres://`/`postgresql://` selects
# PostgreSQL. Production uses a SEPARATE logical database on the same managed
# instance as DATABASE_URL — never the same database.
PAYLOAD_DATABASE_URI="file:./payload.db"

# Signs CMS editor sessions — MUST be replaced in production (32+ chars).
# Deliberately distinct from AUTH_SECRET: that one signs job-seeker sessions,
# and a single leaked value must not compromise both systems.
PAYLOAD_SECRET="dev-only-payload-secret-change-me-0123456789ab"

# --- Staff console (CRM) ---------------------------------------------------
# The client-management console at /console shows customer PII and billing, so
# it is gated separately from ordinary accounts: a comma-separated allowlist of
# staff email addresses, checked against the signed-in user.
#
# It fails closed. Left unset, /console denies everyone — including an admin —
# which is the safe default for a deployment that forgot to configure it, but
# also the reason the page looks "broken" locally until you fill this in. Set it
# to the account you sign in with; the seeded demo account works out of the box:
STAFF_EMAILS="demo@jobpilot.ai"

# --- Providers -------------------------------------------------------------
# Each provider is pluggable. "mock" needs no credentials and powers the demo.

# Job sourcing: mock | adzuna
# Adzuna aggregates Canadian and US postings under a documented API with a free
# tier — register at https://developer.adzuna.com. Falls back to mock if unset.
JOB_PROVIDER="mock"
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# --- Apply engine ----------------------------------------------------------
# How applications reach employers. Stage 12 (ADR-0016, ADR-0026):
# PREPARATION NEVER SUBMITS, in any engine. The engine decides only whether a
# programmatic submission is POSSIBLE later, on the applicant's instruction
# after their review (the applicant's own "Review & submit" mode):
#   mock     — prepares for real; `submit` returns a deterministic confirmation
#              without contacting anyone (default when JOB_PROVIDER=mock)
#   auto     — may submit through an authorized ATS API on instruction; assisted
#              everywhere else (default otherwise)
#   assisted — never submit on the applicant's behalf, whatever credentials exist
#
# Note on `auto`: programmatic submission requires a credential the *employer*
# issues for their board. Without one, JobPilot prepares the application and the
# applicant confirms on the employer's own form. This is deliberate — the major
# job boards prohibit automated submission and enforce it against the
# applicant's account, so we do not drive their forms. There is no setting,
# here or anywhere, that submits without the applicant's click.
APPLY_MODE=""

# Per-employer ATS credentials, when an employer has authorized this deployment.
# Namespaced by vendor and board, e.g.:
#   ATS_GREENHOUSE_ACME="board-token"
#   ATS_LEVER_ACME="lever-api-key"
# A vendor-wide fallback is also read: ATS_GREENHOUSE_DEFAULT, ATS_LEVER_DEFAULT.

# Job source: names a JobSource register row (mock | adzuna). Stage 05: the
# source must also be ENABLED at /console/sources with its policy record
# complete; a key alone does nothing. Adzuna has never been called live.
# (JOB_PROVIDER is declared above with the Adzuna keys.)

# Object storage for application folders (ADR-0015): local | s3. With s3, the
# region must be ca-central-1 or ca-west-1 or the provider refuses to start.
STORAGE_PROVIDER="local"
STORAGE_S3_ENDPOINT=""
STORAGE_S3_REGION="ca-central-1"
STORAGE_S3_BUCKET=""
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""

# AI (resume tailoring, match scoring, interview prep): mock | anthropic
# Stage 03: every task goes through src/lib/ai/gateway.ts. The model, the
# prompt and the parameters come from the governed PromptVersion registry
# (/console/prompts), never from the environment; a task with no default
# prompt version is served by the deterministic engine and recorded as such.
# A key alone enables nothing until an operator promotes an evaluated version.
AI_PROVIDER="mock"
ANTHROPIC_API_KEY=""

# Payments: mock | stripe
PAYMENT_PROVIDER="mock"
STRIPE_SECRET_KEY=""
# Endpoint secret for POST /api/webhooks/stripe. The webhook — not the browser
# redirect — is what activates a subscription.
STRIPE_WEBHOOK_SECRET=""

# Map each plan/interval pair to a Price created in the Stripe dashboard, so the
# amounts customers are charged live in one auditable place. Either form works:
#   STRIPE_PRICE_STARTER_MONTHLY="price_..."
#   STRIPE_PRICE_PROFESSIONAL_ANNUAL="price_..."
# or a single JSON map:
#   STRIPE_PRICE_MAP='{"professional:monthly":"price_...","executive:annual":"price_..."}'
STRIPE_PRICE_MAP=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
# How many trusted proxies append to X-Forwarded-For in front of the app (Stage 14).
# 1 = one load balancer (the managed-hosting default). 0 = believe no forwarded
# header (every anonymous caller shares one rate-limit bucket). Sign-in is also
# budgeted per account, so this is never the only bound on guessing.
TRUSTED_PROXY_HOPS="1"

# Stage 24 (ADR-0038): the rate-limit store. Unset or "memory" keeps counters in
# the process (correct for ONE instance); "postgres" uses the shared
# RateLimitBucket table so N instances share one ceiling (R-16). Set it before
# a second instance. The worker (`npm run worker`) ticks every WORKER_TICK_SECONDS.
RATE_LIMIT_STORE=""
# Minimum 5. Every job is bounded by its own timeout; a job window that fails is retried at the next window.
WORKER_TICK_SECONDS="60"

# ---------------------------------------------------------------------------
# Stage 11 — email and calendar intelligence (ADR-0025). Headers only; no
# message body is ever requested. Nothing here has a default that reaches a
# real provider: without the client credentials the registry refuses the
# adapter, and MAILBOX_CONNECTOR=mock is honoured outside production only.
# ---------------------------------------------------------------------------
# 32 random bytes, base64 or hex. Encrypts OAuth tokens at rest (AES-256-GCM).
# Without it no connection can be stored and the flow refuses.
MAILBOX_ENCRYPTION_KEY=""
# Stage 20 (ADR-0035): a SEPARATE 32-byte key (base64 or hex) for enterprise SSO
# client secrets at rest (AES-256-GCM). Without it no SSO connection can be
# saved; the console says so. Never reuse the mailbox key - one key, one blast radius.
SSO_ENCRYPTION_KEY=""
# Google Cloud OAuth client — scopes gmail.metadata + calendar.events.readonly.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# Microsoft Entra app registration — Mail.ReadBasic, Calendars.Read, offline_access.
MICROSOFT_OAUTH_CLIENT_ID=""
MICROSOFT_OAUTH_CLIENT_SECRET=""
MICROSOFT_OAUTH_TENANT="common"
# "mock" serves the fixture-backed connector (never in production).
MAILBOX_CONNECTOR=""
