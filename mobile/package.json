{
  "name": "jobpilot-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "JobPilot candidate mobile app (Stage 14, ADR-0013): an Expo client that consumes only the frozen candidate API contract in ../docs/api/openapi.candidate.v1.json.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "api:types": "openapi-typescript ../docs/api/openapi.candidate.v1.json -o src/api/schema.d.ts --export-type",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "export:web": "expo export --platform web --output-dir dist --clear",
    "verify": "npm run typecheck && npm test && npm run export:web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "expo": "~57.0.20",
    "expo-constants": "~57.0.17",
    "expo-file-system": "~57.0.6",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "~19.2.2",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  }
}
