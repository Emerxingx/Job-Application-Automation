# Line-ending and generated-file policy — see docs/adr/ADR-0014-generated-files.md
#
# Normalise every text file to LF in the repository, on every platform. Without
# this, a Windows checkout with core.autocrlf=true produces a permanently dirty
# working tree on tool-generated files — which is exactly what was observed on
# src/app/(payload)/admin/importMap.js before this file existed.

* text=auto eol=lf

# --- explicit text -----------------------------------------------------------
*.ts       text eol=lf
*.tsx      text eol=lf
*.js       text eol=lf
*.mjs      text eol=lf
*.cjs      text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.css      text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.prisma   text eol=lf
*.sql      text eol=lf
.env.example text eol=lf

# Large and generated: keep LF, but do not clutter diffs or language stats.
package-lock.json text eol=lf -diff linguist-generated=true

# --- generated, tracked, never hand-edited -----------------------------------
# Both are regenerated by `npm run cms:importmap` / `npm run cms:types` and are
# verified for drift by .github/workflows/ci.yml. They stay tracked because a
# clean clone must build without running codegen.
src/app/(payload)/admin/importMap.js text eol=lf linguist-generated=true
src/payload-types.ts                 text eol=lf linguist-generated=true

# --- binary ------------------------------------------------------------------
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.avif binary
*.svg  text eol=lf
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.db   binary
