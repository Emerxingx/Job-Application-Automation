{
  "name": "jobpilot-ai",
  "version": "0.1.0",
  "private": true,
  "description": "JobPilot AI — AI-powered job application automation for Canada & US",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings=8",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"tests/**/*.test.ts\"",
    "check": "tsc --noEmit && npm test",
    "db:migrate": "node scripts/db/with-encoded-env.mjs prisma migrate dev",
    "db:migrate:deploy": "node scripts/db/with-encoded-env.mjs prisma migrate deploy",
    "db:migrate:status": "node scripts/db/with-encoded-env.mjs prisma migrate status",
    "db:migrate:check": "node scripts/db/with-encoded-env.mjs prisma migrate diff --from-url \"$DIRECT_URL\" --to-schema-datamodel prisma/schema.prisma --exit-code",
    "db:push": "node scripts/db/with-encoded-env.mjs prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "jobs:freshness": "node scripts/db/with-encoded-env.mjs tsx scripts/jobs/freshness.ts",
    "taxonomy:load-learning": "node scripts/db/with-encoded-env.mjs tsx scripts/taxonomy/load-learning.ts",
    "jobs:canonicalize": "node scripts/db/with-encoded-env.mjs tsx scripts/jobs/canonicalize.ts",
    "mailbox:sync": "tsx scripts/mailbox/sync.ts",
    "analytics:rollup": "tsx scripts/analytics/rollup-candidates.ts",
    "api:freeze": "tsx scripts/api/freeze-contract.ts",
    "db:reset": "node scripts/db/with-encoded-env.mjs prisma migrate reset --force",
    "postinstall": "prisma generate",
    "cms:types": "node scripts/payload-cli.mjs generate:types",
    "cms:importmap": "node scripts/payload-cli.mjs generate:importmap",
    "verify": "npm run lint:ci && tsc --noEmit && npm test && npm run build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/db-sqlite": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "docx": "^9.7.1",
    "graphql": "^16.8.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.469.0",
    "next": "^16.3.4",
    "payload": "3.88.0",
    "pdfkit": "^0.19.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "sharp": "^0.35.3",
    "stripe": "^17.7.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "8.20.0",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "pg": "8.20.0",
    "postcss": "^8.4.49",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "fast-uri": "^3.1.7",
    "qs": "^6.16.0"
  }
}
